# Docker mode (default). Installed as /etc/systemd/system/naukri-refresher.service.
#
# Why this unit runs as root: talking to the Docker socket is root-equivalent, so giving the
# `naukri` user the docker group would make it root anyway. Instead this unit (root) only runs
# scripts/docker-run.sh, and Chromium runs inside a hardened container as the unprivileged
# `naukri` UID (--read-only, --cap-drop=ALL, no-new-privileges, memory/pids limits).
# The systemd sandboxing below confines the wrapper script, not the container: dockerd
# starts the container, outside this unit's cgroup and namespaces.
#
# Credentials: the drop-in naukri-refresher.service.d/credentials.conf (written by
# scripts/set-credentials.sh) adds one LoadCredentialEncrypted= line per stored secret.

[Unit]
Description=Naukri profile refresher (Docker)
Documentation=file:///opt/naukri-refresher/README.md
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/naukri-refresher/scripts/docker-run.sh
# "+" = run outside the sandbox: /run is read-only under ProtectSystem=strict.
ExecStopPost=+/bin/sh -c 'docker rm -f naukri-refresher >/dev/null 2>&1 || true; rm -f /run/naukri-refresher.oneshot.env'
# One-shot flags (NAUKRI_DRY_RUN=1) written by scripts/run-now.sh --dry-run; removed after the run.
EnvironmentFile=-/run/naukri-refresher.oneshot.env
# ProtectHome hides /root; keep the docker CLI's config in the runtime dir instead.
Environment=DOCKER_CONFIG=/run/naukri-refresher/docker
Environment=NAUKRI_IMAGE=naukri-refresher:latest
# Two attempts + 60 s retry delay fit comfortably; a hung run is killed.
TimeoutStartSec=25min
# The app's own retry handles failures. No systemd restarts.
Restart=no
RuntimeDirectory=naukri-refresher
RuntimeDirectoryMode=0700

# Hardening for the wrapper (see note above about what it does and does not cover).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/naukri-refresher
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The docker CLI only needs the Unix socket.
RestrictAddressFamilies=AF_UNIX
# Relaxation: the wrapper chowns the decrypted credential copy to the naukri UID so the
# container user can read it. CAP_CHOWN + CAP_FOWNER are the only capabilities kept.
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
UMask=0077

[Install]
# Started by naukri-refresher.timer; not enabled on its own.
