{
  "name": "naukri-refresher",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Playwright job that keeps your own Naukri profile fresh, run by a systemd timer on a Raspberry Pi.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dry-run": "node dist/index.js --dry-run",
    "manual-login": "tsx scripts/manual-login.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:flow": "vitest run tests/flow"
  },
  "dependencies": {
    "pino": "10.4.0",
    "playwright": "1.64.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
